# ================================================================
# Education Loan Support Agent - Environment Configuration
# ================================================================

# Database Configuration (Priority 6: Dual-Engine Architecture)
# Development (default): SQLite
DATABASE_URL=sqlite:///students.db

# Production: PostgreSQL (Enterprise Ready)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/eduloan_production

# Google Gemini Vision API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Environment Mode
ENVIRONMENT=development
